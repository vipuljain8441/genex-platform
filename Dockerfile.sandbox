FROM codercom/code-server:latest

USER root

# Install Python 3, Node.js 20 LTS, SQLite3, build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    sqlite3 \
    git \
    curl \
    make \
    build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Symlinks so 'python' and 'pip' resolve without version suffix
RUN ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip

# Common Python packages for assessments
RUN pip3 install --no-cache-dir --break-system-packages \
    requests numpy pandas pytest black isort flask fastapi httpx

# Configure git for candidates
RUN git config --system user.email "candidate@genex.dev" \
    && git config --system user.name "Candidate" \
    && git config --system init.defaultBranch main \
    && git config --system core.autocrlf false

# Pre-create directories for user-level VS Code settings
RUN mkdir -p /home/coder/.local/share/code-server/User \
    && chown -R 1000:1000 /home/coder/.local

# Copy locked-down user settings and keybindings
COPY --chown=1000:1000 .devcontainer/sandbox-vscode-settings.json \
    /home/coder/.local/share/code-server/User/settings.json
COPY --chown=1000:1000 .devcontainer/sandbox-vscode-keybindings.json \
    /home/coder/.local/share/code-server/User/keybindings.json

# Inject custom CSS into workbench HTML at build time (runs as root)
COPY .devcontainer/sandbox-custom.css /tmp/sandbox-custom.css
RUN python3 - <<'EOF'
import pathlib, sys
html_path = pathlib.Path("/usr/lib/code-server/lib/vscode/out/vs/code/browser/workbench/workbench.html")
css = pathlib.Path("/tmp/sandbox-custom.css").read_text()
content = html_path.read_text()
marker = "genex-sandbox-css"
if marker not in content:
    block = f"<!-- {marker} --><style>{css}</style>"
    content = content.replace("</head>", block + "\n</head>", 1)
    html_path.write_text(content)
    print(f"[dockerfile] CSS injected into {html_path}")
else:
    print("[dockerfile] CSS already injected, skipping")
EOF

# Copy GenEx sync server and entrypoint
COPY .devcontainer/sandbox-sync-server.py /usr/local/bin/sandbox-sync-server.py
COPY .devcontainer/sandbox-entrypoint.sh /usr/local/bin/sandbox-entrypoint.sh
RUN chmod +x /usr/local/bin/sandbox-sync-server.py \
    && chmod +x /usr/local/bin/sandbox-entrypoint.sh \
    && mkdir -p /home/coder/sessions \
    && chown -R 1000:1000 /home/coder/sessions

USER 1000

ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint.sh"]

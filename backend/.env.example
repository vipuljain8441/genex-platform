GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Where the candidate-facing app lives (used in invite emails)
APP_BASE_URL=http://localhost:3000

# Optional — email provider for candidate invites. If RESEND_API_KEY is unset,
# invites still work but the employer copies the link from the UI manually.
# Grab a free key at https://resend.com (3k emails/mo on the free tier).
RESEND_API_KEY=
RESEND_FROM_EMAIL=GenEx <onboarding@resend.dev>

STORE_BACKEND=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genex

# Choose ONE setup:
#
# 1) Local OpenAI-compatible model (for example Ollama)
LLM_TYPE=local
LLM_PROVIDER=openai_compatible
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:0.5b
LLM_API_BASE=http://localhost:11434/v1
#
# 2) Native Amazon Bedrock via Converse API
# LLM_TYPE=bedrock
# LLM_PROVIDER=bedrock
# LLM_MODEL=global.anthropic.claude-sonnet-4-6
# BEDROCK_REGION=ap-south-1
# BEDROCK_AUTH_MODE=iam
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# LLM_API_KEY=
#
# 3) Groq
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_BASE=

# Backward-compatible aliases for older local setups.
GROQ_API_KEY=
GROQ_MODEL=

ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Where the candidate-facing app lives (used in invite emails)
APP_BASE_URL=http://localhost:3000

# Optional — email provider for candidate invites. If RESEND_API_KEY is unset,
# invites still work but the employer copies the link from the UI manually.
# Grab a free key at https://resend.com (3k emails/mo on the free tier).
RESEND_API_KEY=
RESEND_FROM_EMAIL=GenEx <onboarding@resend.dev>
